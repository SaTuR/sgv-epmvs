APP_NAME=Sistema de Gestión y Venta EPMVS
APP_ENV=development
TZ=America/Guayaquil

POSTGRES_DB=sgv_epmvs
POSTGRES_USER=sgv_epmvs
POSTGRES_PASSWORD=CAMBIAR_CLAVE_SEGURA

DATABASE_URL=postgresql+psycopg://sgv_epmvs:CAMBIAR_CLAVE_SEGURA@db:5432/sgv_epmvs

SECRET_KEY=CAMBIAR_SECRET_KEY
JWT_SECRET_KEY=CAMBIAR_JWT_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080/api/public/documents
UPLOAD_PATH=/app/storage
